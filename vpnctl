#!/bin/sh
# Команда доступна из каталога исходников и после установки в /usr/local/sbin.
set -eu
# Ранние сообщения установки доступны ещё до появления Python.
terminal_message() {
  style=36
  case "$1" in Ошибка:*) style=31 ;; esac
  if [ -t 2 ] && [ "${NO_COLOR+x}" != x ] && [ "${TERM:-}" != dumb ]; then
    printf '\033[%sm%s\033[0m\n' "$style" "$1" >&2
  else
    printf '%s\n' "$1" >&2
  fi
}
launcher=$0
while [ -L "$launcher" ]; do
  location=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd)
  target=$(readlink "$launcher")
  case "$target" in /*) launcher=$target ;; *) launcher=$location/$target ;; esac
done
base=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd)
if [ ! -r "$base/lib/vpnctl_manager.py" ]; then
  # Проверка выполняется встроенным shell-кодом до импорта Python из снимка.
  trusted_path() {
    checked=$1
    while :; do
      [ ! -L "$checked" ] && [ -e "$checked" ] || { terminal_message 'Ошибка: небезопасная ссылка установленного CLI'; exit 73; }
      owner=$(stat -c %u -- "$checked")
      mode=$(stat -c %a -- "$checked")
      [ "$owner" = 0 ] && [ "$((0$mode & 022))" -eq 0 ] || { terminal_message 'Ошибка: небезопасные права установленного CLI'; exit 73; }
      [ "$checked" != / ] || break
      checked=$(dirname -- "$checked")
    done
  }
  trusted_path /etc/vpn-easy-dual-install-dir
  [ -r /etc/vpn-easy-dual-install-dir ] || { terminal_message 'Ошибка: каталог установки vpnctl не найден'; exit 69; }
  IFS= read -r base < /etc/vpn-easy-dual-install-dir
  trusted_path "$base"
  trusted_path "$base/lib"
  for source in "$base"/lib/*.py "$base"/lib/*.sh "$base"/vpnctl "$base"/awg-easy-3; do
    [ ! -e "$source" ] || trusted_path "$source"
  done
fi
case "$base" in /*) ;; *) terminal_message 'Ошибка: некорректный каталог установки'; exit 65 ;; esac
action=
config=/etc/vpn-easy-dual/config.json
take_config=0
for argument in "$@"; do
  if [ "$take_config" -eq 1 ]; then config=$argument; take_config=0; continue; fi
  case "$argument" in --config) take_config=1 ;; --config=*) config=${argument#--config=} ;; --help|-h|-help) action=help; break ;; -*) action=install; break ;; *) action=$argument; break ;; esac
done
case "$config" in /*) ;; *) config=$base/$config ;; esac
if [ "$action" = help ] && ! command -v python3 >/dev/null 2>&1; then
  exec sh "$base/lib/vpnctl-install-validate.sh" --help
fi
if [ -z "$action" ] && [ ! -r "$config" ]; then set -- "$@" install; action=install; fi
if [ "$action" = install ] || [ "$action" = reinstall ]; then
  if command -v python3 >/dev/null 2>&1; then
    python3 "$base/lib/vpnctl_manager.py" --validate-only "$@"
  else
    sh "$base/lib/vpnctl-install-validate.sh" "$@"
  fi
  for argument in "$@"; do
    case "$argument" in --help|-h|-help) exit 0 ;; esac
  done
fi
if { [ "$action" = install ] || [ "$action" = reinstall ]; } && [ ! -r "$config" ]; then
  dry=0; provision=
  for argument in "$@"; do case "$argument" in --dry-run|--uninstall) dry=1 ;; --yes) provision=--yes ;; esac; done
  if [ "$dry" -eq 0 ]; then
    [ "$(id -u)" -eq 0 ] || { terminal_message 'Ошибка: запустите установку через sudo'; exit 69; }
    install -d -m 0755 /run/lock
    bootstrap_lock=/run/lock/awg-easy-3-update.lock
    mkdir "$bootstrap_lock" 2>/dev/null || { terminal_message 'Ошибка: другая операция установки или обновления уже выполняется'; exit 73; }
    printf '%s\n' "$$" > "$bootstrap_lock/pid"
    trap 'if [ -r "$bootstrap_lock/pid" ] && [ "$(cat "$bootstrap_lock/pid")" = "$$" ]; then rm -f "$bootstrap_lock/pid"; rmdir "$bootstrap_lock" 2>/dev/null || true; fi' 0
    terminal_message '[Установка] Проверка и подготовка системных зависимостей [...###..............]'
    sh "$base/lib/dual-dependencies.sh" "$provision" >&2
    terminal_message '[Установка] Системные зависимости готовы [####################]'
    VPNCTL_BOOTSTRAP_LOCK=$$
    export VPNCTL_BOOTSTRAP_LOCK
  fi
fi
command -v python3 >/dev/null 2>&1 || { terminal_message 'Ошибка: требуется Python 3; для установки выполните sudo vpnctl install'; exit 69; }
if [ -n "${VPNCTL_BOOTSTRAP_LOCK:-}" ]; then
  python3 "$base/lib/vpnctl_manager.py" "$@"
else
  exec python3 "$base/lib/vpnctl_manager.py" "$@"
fi
